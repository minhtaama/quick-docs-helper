# ==========================================
# Comprehensive .gitignore for quick-docs-helper
# ==========================================

# 1. Python Environment & Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
eggs/
.eggs/

# 2. Environment Variables & Secrets
.env
.env.local
.env.*.local

# 3. Project Specific Outputs & Logs
temp_outputs/
*.log
*.tmp

# 4. Flutter & Dart Sub-Projects
**/.dart_tool/
**/.pub/
**/.pub-cache/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/ephemeral/
**/windows/flutter/ephemeral/
**/android/.gradle/
**/android/local.properties
**/*.iml
**/.idea/
**/.metadata

# 5. Build Artifacts & Generated Files
static/
data/
