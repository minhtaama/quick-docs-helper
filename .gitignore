# ==========================================
# Comprehensive .gitignore for quick-docs-helper
# ==========================================

# 1. Python Environment & Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
eggs/
.eggs/

# 2. Environment Variables & Secrets
.env
.env.local
.env.*.local

# 3. Project Specific Outputs & Logs
temp_outputs/
*.log
*.tmp

# 4. Flutter & Dart Sub-Project (flutter_app)
flutter_app/.dart_tool/
flutter_app/.pub/
flutter_app/.pub-cache/
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/ephemeral/
flutter_app/windows/flutter/ephemeral/
flutter_app/android/.gradle/
flutter_app/android/local.properties

# 5. IDEs & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 6. Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Generated static files (built automatically by main.py from Flutter)
static/

# Flutter specific IDE & metadata files
flutter/*.iml
flutter_app/*.iml
flutter/.idea/
flutter_app/.idea/
flutter/.metadata

# Flutter Sub-Project (flutter)
flutter/.dart_tool/
flutter/.pub/
flutter/.pub-cache/
flutter/build/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.packages
flutter/ephemeral/
